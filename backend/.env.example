# Copy to backend/.env and fill in. Every variable below except the analytics
# block is checked at startup — the server logs missing ones in development and
# refuses to boot on them in production.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/zenith

# ── Auth ──────────────────────────────────────────────────────────────────────
# Clerk dashboard → API Keys → Secret key
CLERK_SECRET_KEY=

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Origins ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Comma-separated allowlist used by CORS
ALLOWED_ORIGINS=http://localhost:5173

# ── Web push (VAPID) ──────────────────────────────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_EMAIL=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Shared secret for the X-Admin-Token break-glass routes
ADMIN_SECRET=
# Clerk user ID that `node grant-admin.js` promotes to is_admin
ADMIN_CLERK_ID=

# ── Product analytics (optional) ──────────────────────────────────────────────
# Leave blank to disable — analytics no-ops entirely without a key, so local
# development and CI need no account. EU host keeps event data in the EU.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
